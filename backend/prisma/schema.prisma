generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String @id
  fullName               String
  email                  String
  age                    Int
  city                   String
  profession             String
  monthlyIncome          Float
  lifestyleType          String
  monthlySavingsEstimate Float

  transactions  Transaction[]
  subscriptions Subscription[]
  productivity  Productivity[]
  anomalies     Anomaly[]
}

model Transaction {
  id                 String   @id
  userId             String
  timestamp          DateTime
  category           String
  merchant           String
  amount             Float
  paymentMethod      String
  location           String
  isWeekend          Boolean
  isNightTransaction Boolean

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id                    String   @id
  userId                String
  serviceName           String
  category              String
  monthlyCost           Float
  renewalDate           DateTime
  active                Boolean
  autoPayEnabled        Boolean
  subscriptionStartDate DateTime
  usageFrequency        String

  user User @relation(fields: [userId], references: [id])
}

model Productivity {
  id                String   @id
  userId            String
  date              DateTime
  sleepHours        Float
  workHours         Float
  focusSessions     Int
  meetingsCount     Int
  screenTimeHours   Float
  stressLevel       Int
  productivityScore Float
  burnoutRisk       Boolean

  user User @relation(fields: [userId], references: [id])
}

model Anomaly {
  id                 String   @id
  userId             String
  timestamp          DateTime
  category           String
  merchant           String
  amount             Float
  paymentMethod      String
  location           String
  isWeekend          Boolean
  isNightTransaction Boolean
  isAnomaly          Boolean
  anomalyType        String

  user User @relation(fields: [userId], references: [id])
}
